@baseUrl = http://localhost:5432/api
@token = COLE_SEU_TOKEN_JWT_AQUI

##################################################
################### AUTH ##########################
##################################################

### Cadastro
POST {{baseUrl}}/auth/cadastro
Content-Type: application/json

{
  "nome_usuario": "teste",
  "email": "teste@email.com",
  "senha": "123456"
}

### Loginclear
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "teste@email.com",
  "senha": "123456"
}

##################################################
################ AVALIACOES ######################
##################################################

### Destaques
GET {{baseUrl}}/avaliacoes/destaque

### Listar
GET {{baseUrl}}/avaliacoes?page=1&limit=10

### Buscar por ID
GET {{baseUrl}}/avaliacoes/1

### Criar (precisa token)
POST {{baseUrl}}/avaliacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_jogo_fk": 1,
  "nota": 9,
  "titulo": "Muito bom",
  "texto": "Esse jogo é excelente, tem mais de 40 caracteres para passar na validação."
}

### Atualizar
PUT {{baseUrl}}/avaliacoes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nota": 8,
  "titulo": "Atualizado",
  "texto": "Texto atualizado com mais de 40 caracteres para continuar válido."
}

### Deletar
DELETE {{baseUrl}}/avaliacoes/1
Authorization: Bearer {{token}}

### Curtir
POST {{baseUrl}}/avaliacoes/1/curtir
Authorization: Bearer {{token}}

### Comentar
POST {{baseUrl}}/avaliacoes/1/comentar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "texto": "Comentário teste"
}

##################################################
################### JOGOS ########################
##################################################

### Stats
GET {{baseUrl}}/jogos/stats

### Destaques
GET {{baseUrl}}/jogos/destaques

### Listar
GET {{baseUrl}}/jogos?search=zelda&page=1&limit=10

### Buscar por ID
GET {{baseUrl}}/jogos/1

### Criar (ADMIN)
POST {{baseUrl}}/jogos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_jogo": "Novo Jogo",
  "desenvolvedora": "Empresa X",
  "data_lancamento": "2024-01-01",
  "descricao": "Descrição do jogo",
  "capa": "url_da_capa",
  "generos": [1],
  "plataformas": [1]
}

### Atualizar
PUT {{baseUrl}}/jogos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_jogo": "Atualizado",
  "desenvolvedora": "Empresa Y",
  "data_lancamento": "2024-02-01",
  "descricao": "Nova descrição",
  "capa": "nova_url"
}

### Deletar
DELETE {{baseUrl}}/jogos/1
Authorization: Bearer {{token}}

##################################################
################### MISC #########################
##################################################

### Enviar contato
POST {{baseUrl}}/contato
Content-Type: application/json

{
  "email_contato": "email@email.com",
  "tipo": "Sugestão",
  "mensagem": "Mensagem de teste"
}

### Listar contatos (ADMIN)
GET {{baseUrl}}/contato
Authorization: Bearer {{token}}

### Generos
GET {{baseUrl}}/generos

### Plataformas
GET {{baseUrl}}/plataformas

##################################################
################### USUARIOS #####################
##################################################

### Meu perfil
GET {{baseUrl}}/usuarios/me
Authorization: Bearer {{token}}

### Atualizar perfil
PUT {{baseUrl}}/usuarios/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_usuario": "novo_nome",
  "email": "novo@email.com",
  "senha": "nova_senha"
}

### Minhas avaliacoes
GET {{baseUrl}}/usuarios/me/avaliacoes
Authorization: Bearer {{token}}

### Notificacoes
GET {{baseUrl}}/usuarios/me/notificacoes
Authorization: Bearer {{token}}

### Seguir usuario
POST {{baseUrl}}/usuarios/2/seguir
Authorization: Bearer {{token}}

##################################################
################### ADMIN ########################
##################################################

### Listar usuarios
GET {{baseUrl}}/usuarios
Authorization: Bearer {{token}}

### Atualizar perfil usuario
PUT {{baseUrl}}/usuarios/2/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_perfil_fk": 2
}

### Deletar usuario
DELETE {{baseUrl}}/usuarios/2
Authorization: Bearer {{token}}