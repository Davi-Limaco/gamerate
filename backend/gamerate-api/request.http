# =============================================================
#  GameRate API — Testes das Rotas (REST Client / VSCode)
#  Servidor: http://localhost:3000
# =============================================================

@base = http://localhost:3000/api
@token = {{login.response.body.$.token}}
@invalidToken = invalid.jwt.token

# =============================================================
#  AUTH — Login e Cadastro
# =============================================================

### [AUTH] Cadastrar novo usuário
POST {{base}}/auth/cadastro
Content-Type: application/json

{
  "nome_usuario": "Teste",
  "email": "teste@teste.com",
  "senha": "senha123"
}

###

### [AUTH] Login válido (captura o JWT para as requisições seguintes)
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@gamerate.com",
  "senha": "admin123"
}

###

### [AUTH] Acesso protegido sem token (esperado: 401)
GET {{base}}/usuarios/me

###

### [AUTH] Acesso protegido com token válido (esperado: 200)
GET {{base}}/usuarios/me
Authorization: Bearer {{token}}

###

### [AUTH] Acesso protegido com token inválido (esperado: 401)
GET {{base}}/usuarios/me
Authorization: Bearer {{invalidToken}}

###

# =============================================================
#  JOGOS — CRUD completo
# =============================================================

### [JOGOS] Listar todos
GET {{base}}/jogos

###

### [JOGOS] Buscar por nome
GET {{base}}/jogos?search=Elden

###

### [JOGOS] Filtrar por gênero
GET {{base}}/jogos?genero=RPG

###

### [JOGOS] Filtrar por plataforma
GET {{base}}/jogos?plataforma=PC

###

### [JOGOS] Buscar por ID
GET {{base}}/jogos/1

###

### [JOGOS] Criar novo jogo (CREATE)
POST {{base}}/jogos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_jogo": "Celeste",
  "desenvolvedora": "Maddy Thorson",
  "data_lancamento": "2018-01-25",
  "descricao": "Um platformer desafiador sobre uma garota escalando a montanha Celeste, premiado pela narrativa sobre saúde mental.",
  "capa": "/assets/celeste.jpg",
  "generos": [9, 11],
  "plataformas": [1, 6]
}

###

### [JOGOS] Atualizar jogo (UPDATE)
PUT {{base}}/jogos/9
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_jogo": "Celeste (Atualizado)",
  "desenvolvedora": "Maddy Thorson & Noel Berry",
  "data_lancamento": "2018-01-25",
  "descricao": "Platformer aclamado com narrativa sobre saúde mental e mecânicas de movimento únicas.",
  "capa": "/assets/celeste.jpg"
}

###

### [JOGOS] Excluir jogo (DELETE)
DELETE {{base}}/jogos/9
Authorization: Bearer {{token}}

###

### [JOGOS] Estatísticas do catálogo
GET {{base}}/jogos/stats

###

### [JOGOS] Jogos em destaque
GET {{base}}/jogos/destaques

###

# =============================================================
#  AVALIAÇÕES — CRUD completo
# =============================================================

### [AVALIAÇÕES] Listar todas
GET {{base}}/avaliacoes

###

### [AVALIAÇÕES] Filtrar por jogo
GET {{base}}/avaliacoes?jogo_id=1

###

### [AVALIAÇÕES] Avaliações em destaque (maior nota)
GET {{base}}/avaliacoes/destaque

###

### [AVALIAÇÕES] Buscar por ID
GET {{base}}/avaliacoes/1

###

### [AVALIAÇÕES] Criar avaliação (CREATE)
# O autor e obtido do JWT; nao envie id_usuario_fk no corpo
POST {{base}}/avaliacoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_jogo_fk": 1,
  "nota": 4.5,
  "titulo": "Obra-prima do RPG de ação",
  "texto": "Elden Ring redefine o gênero. A liberdade de exploração combinada com o desafio característico da FromSoftware cria uma experiência inesquecível."
}

###

### [AVALIAÇÕES] Atualizar avaliação (UPDATE)
PUT {{base}}/avaliacoes/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nota": 5,
  "titulo": "A melhor experiência dos jogos modernos",
  "texto": "Após zerado, posso dizer com certeza: Elden Ring é uma das maiores conquistas do medium."
}

###

### [AVALIAÇÕES] Excluir avaliação (DELETE)
DELETE {{base}}/avaliacoes/1
Authorization: Bearer {{token}}

###

# =============================================================
#  USUÁRIOS — CRUD completo
# =============================================================

### [USUÁRIOS] Listar todos
GET {{base}}/usuarios
Authorization: Bearer {{token}}

###

### [USUÁRIOS] Buscar por ID
GET {{base}}/usuarios/1
Authorization: Bearer {{token}}

###

### [USUÁRIOS] Avaliações de um usuário
GET {{base}}/usuarios/1/avaliacoes
Authorization: Bearer {{token}}

###

### [USUÁRIOS] Criar usuário (CREATE)
POST {{base}}/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_usuario": "Teste2",
  "email": "teste2@teste.com",
  "senha": "senha456",
  "id_perfil_fk": 1
}

###

### [USUÁRIOS] Atualizar usuário (UPDATE)
PUT {{base}}/usuarios/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_usuario": "Teste2 Atualizada",
  "email": "teste2@teste.com"
}

###

### [USUÁRIOS] Alterar perfil do usuário
PUT {{base}}/usuarios/2/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_perfil_fk": 2
}

###

### [USUÁRIOS] Excluir usuário (DELETE)
DELETE {{base}}/usuarios/2
Authorization: Bearer {{token}}

###

# =============================================================
#  CATÁLOGO — Gêneros, Plataformas e Perfis
# =============================================================

### [GÊNEROS] Listar todos
GET {{base}}/generos

###

### [GÊNEROS] Criar (CREATE)
POST {{base}}/generos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_genero": "Soulslike"
}

###

### [GÊNEROS] Excluir (DELETE)
DELETE {{base}}/generos/16
Authorization: Bearer {{token}}

###

### [PLATAFORMAS] Listar todas
GET {{base}}/plataformas

###

### [PLATAFORMAS] Criar (CREATE)
POST {{base}}/plataformas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_plataforma": "PlayStation Portable"
}

###

### [PLATAFORMAS] Excluir (DELETE)
DELETE {{base}}/plataformas/11
Authorization: Bearer {{token}}

###

### [PERFIS] Listar todos
GET {{base}}/perfis

###

### [PERFIS] Criar (CREATE)
POST {{base}}/perfis
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_perfil": "Moderador"
}

###

### [PERFIS] Atualizar (UPDATE)
PUT {{base}}/perfis/4
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome_perfil": "Moderador Sênior"
}

###

### [PERFIS] Excluir (DELETE)
DELETE {{base}}/perfis/4
Authorization: Bearer {{token}}

###

# =============================================================
#  CONTATO — Formulário público
# =============================================================

### [CONTATO] Listar todas as mensagens
GET {{base}}/contato
Authorization: Bearer {{token}}

###

### [CONTATO] Enviar mensagem (CREATE)
POST {{base}}/contato
Content-Type: application/json

{
  "email_contato": "usuario@email.com",
  "tipo": "Dúvida",
  "mensagem": "Gostaria de saber como funciona o sistema de avaliações do GameRate."
}

###

### [CONTATO] Excluir mensagem (DELETE)
DELETE {{base}}/contato/1
Authorization: Bearer {{token}}

###

### [CONTATO] Listar mensagens (GET)
GET http://localhost:3000/api/contato
Authorization: Bearer {{token}}

# =============================================================
#  CASOS INVÁLIDOS — Validação e tratamento de erros
# =============================================================

### [AUTH] Login com senha incorreta (esperado: 401)
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@gamerate.com",
  "senha": "senhaerrada"
}

###

### [AUTH] Cadastro com e-mail já existente (esperado: 400)
POST {{base}}/auth/cadastro
Content-Type: application/json

{
  "nome_usuario": "Admin Duplicado",
  "email": "admin@gamerate.com",
  "senha": "senha123"
}

###

### [JOGOS] Buscar jogo com ID inexistente (esperado: 404)
GET {{base}}/jogos/99999

###

### [JOGOS] Criar jogo sem campos obrigatórios (esperado: 400)
POST {{base}}/jogos
Content-Type: application/json

{
  "nome_jogo": "Jogo Incompleto"
}

###

### [AVALIAÇÕES] Criar avaliação duplicada no mesmo jogo (esperado: 409)
# Requer que o usuário 1 já tenha avaliado o jogo 1
POST {{base}}/avaliacoes
Content-Type: application/json

{
  "id_usuario_fk": 1,
  "id_jogo_fk": 1,
  "nota": 3,
  "titulo": "Tentativa duplicada",
  "texto": "Esta avaliação deve falhar pois o usuário já avaliou este jogo."
}

###

### [AVALIAÇÕES] Criar avaliação com nota fora do intervalo (esperado: 400)
POST {{base}}/avaliacoes
Content-Type: application/json

{
  "id_usuario_fk": 2,
  "id_jogo_fk": 2,
  "nota": 10,
  "titulo": "Nota inválida",
  "texto": "A nota 10 está fora do intervalo permitido de 1 a 5."
}

###

### [USUÁRIOS] Buscar usuário com ID inexistente (esperado: 404)
GET {{base}}/usuarios/99999

###

### [CONTATO] Enviar contato sem campos obrigatórios (esperado: 400)
POST {{base}}/contato
Content-Type: application/json

{
  "email_contato": "teste@email.com"
}

###