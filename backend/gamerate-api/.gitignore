# Node / backend
backend/gamerate-api/node_modules/
backend/gamerate-api/.env
backend/gamerate-api/.env.*
!backend/gamerate-api/.env.example
backend/gamerate-api/dist/
backend/gamerate-api/coverage/

# SQLite local de desenvolvimento
backend/gamerate-api/src/database/*.sqlite
backend/gamerate-api/src/database/*.sqlite-journal

# Uploads de usuários (fotos de perfil): conteúdo ignorado, estrutura mantida
# (uploads/.gitignore + avatars/ e midias/.gitignore; a API também recria as
# pastas ao iniciar).
uploads/avatars/*
!uploads/avatars/.gitignore
uploads/midias/*
!uploads/midias/.gitignore

# Artefatos de testes (cobertura, relatórios, bancos e uploads descartáveis)
coverage/
playwright-report/
test-results/
uploads-test/
uploads-e2e/
src/database/test.sqlite*
src/database/e2e.sqlite*

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Optional: arquivos temporários do ambiente
*.tmp

# Arquivo gerado por test-files/gerar-midia-grande.mjs (acima do limite de upload)
test-files/midia-grande.mp4
