# Node / backend
backend/gamerate-api/node_modules/
backend/gamerate-api/.env
backend/gamerate-api/.env.*
!backend/gamerate-api/.env.example
backend/gamerate-api/dist/
backend/gamerate-api/coverage/

# SQLite local de desenvolvimento
backend/gamerate-api/src/database/*.sqlite
backend/gamerate-api/src/database/*.sqlite-journal

# Uploads de usuários (fotos de perfil): conteúdo ignorado, estrutura mantida
# (uploads/.gitignore + uploads/avatars/.gitignore; a API também recria as
# pastas ao iniciar).
uploads/avatars/*
!uploads/avatars/.gitignore

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Optional: arquivos temporários do ambiente
*.tmp
