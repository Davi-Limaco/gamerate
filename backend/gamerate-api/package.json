{
  "name": "gamerate-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:reload": "npm run db:drop && npm run db:load",
    "db:load": "tsx src/database/load.ts",
    "db:drop": "tsx src/database/drop.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
