# Ambiente do servidor usado pelos testes de ponta a ponta (Playwright).
# Porta, banco e uploads próprios: não interferem no ambiente de desenvolvimento.
PORT=3100
DATABASE_URL="file:../src/database/e2e.sqlite"
NODE_ENV="test"
JWT_SECRET="segredo-somente-para-testes-e2e"
JWT_EXPIRES_IN="2h"
SMTP_DISABLED=true
UPLOAD_DIR="uploads-e2e"
UPLOAD_MAX_BYTES=2097152
# Limite menor para os testes: o caso "mídia grande demais" não precisa de 30 MB
UPLOAD_MIDIA_MAX_BYTES=5242880
