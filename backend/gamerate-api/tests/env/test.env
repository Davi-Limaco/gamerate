# Ambiente dos testes de unidade e de rotas (node:test + supertest).
# Banco SQLite descartável, próprio dos testes: nunca toca o db.sqlite de desenvolvimento.
DATABASE_URL="file:../src/database/test.sqlite"
NODE_ENV="test"
JWT_SECRET="segredo-somente-para-testes-automatizados"
JWT_EXPIRES_IN="2h"
# Nenhum e-mail é enviado nem conta Ethereal criada (jsonTransport em memória).
SMTP_DISABLED=true
# Uploads dos testes ficam em pasta própria, apagada ao final.
UPLOAD_DIR="uploads-test"
UPLOAD_MAX_BYTES=2097152
