generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Perfil {
  id_perfil   Int       @id @default(autoincrement())
  nome_perfil String    @unique
  usuarios    Usuario[]

  @@map("perfil")
}

model Usuario {
  id_usuario   Int         @id @default(autoincrement())
  nome_usuario String
  email        String      @unique
  senha        String
  id_perfil_fk Int
  data_criacao DateTime    @default(dbgenerated("CURRENT_DATE"))
  perfil       Perfil      @relation(fields: [id_perfil_fk], references: [id_perfil], onDelete: NoAction, onUpdate: NoAction)
  avaliacoes   Avaliacao[]
  imagem       Imagem?
  favoritos    Favorito[]
  midias       Midia[]

  @@map("usuario")
}

// Foto de perfil (avatar) do usuário. A regra "um arquivo por usuário" é
// garantida pelo próprio banco: `id_usuario_fk` é @unique (relação 1:1), então
// um novo envio faz UPDATE do caminho em vez de criar um segundo registro.
// `caminho` guarda só o caminho público (ex.: /uploads/avatars/<uuid>.png),
// nunca o nome enviado pelo cliente. Ao remover o usuário, a imagem vai junto
// (onDelete: Cascade); o arquivo em disco é apagado pela aplicação.
model Imagem {
  id_imagem     Int      @id @default(autoincrement())
  caminho       String
  id_usuario_fk Int      @unique
  data_envio    DateTime @default(now())
  usuario       Usuario  @relation(fields: [id_usuario_fk], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@map("imagem")
}

// Jogo favorito de um usuário (relação N:N entre Usuario e Jogo). A chave
// única composta impede favoritar o mesmo jogo duas vezes (-> 409 na API).
model Favorito {
  id_favorito   Int      @id @default(autoincrement())
  id_usuario_fk Int
  id_jogo_fk    Int
  data_criacao  DateTime @default(now())
  usuario       Usuario  @relation(fields: [id_usuario_fk], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
  jogo          Jogo     @relation(fields: [id_jogo_fk], references: [id_jogo], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario_fk, id_jogo_fk])
  @@map("favorito")
}

// Print ou vídeo de gameplay postado por um usuário. `tipo` ('imagem' |
// 'video') é derivado do conteúdo do arquivo pelo servidor, nunca informado
// pelo cliente. O jogo é opcional: se o jogo for removido, a mídia permanece.
model Midia {
  id_midia      Int      @id @default(autoincrement())
  tipo          String
  caminho       String
  titulo        String
  descricao     String?
  id_usuario_fk Int
  id_jogo_fk    Int?
  data_envio    DateTime @default(now())
  usuario       Usuario  @relation(fields: [id_usuario_fk], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
  jogo          Jogo?    @relation(fields: [id_jogo_fk], references: [id_jogo], onDelete: SetNull, onUpdate: NoAction)

  @@index([id_usuario_fk])
  @@map("midia")
}

model Jogo {
  id_jogo          Int               @id @default(autoincrement())
  nome_jogo        String
  desenvolvedora   String
  data_lancamento  DateTime
  descricao        String
  nota_media       Float?
  total_avaliacoes Int               @default(0)
  capa             String?
  avaliacoes       Avaliacao[]
  generos          JogoGenero[]
  plataformas      JogoPlataforma[]
  favoritos        Favorito[]
  midias           Midia[]

  @@map("jogo")
}

model Plataforma {
  id_plataforma   Int              @id @default(autoincrement())
  nome_plataforma String           @unique
  jogos           JogoPlataforma[]

  @@map("plataforma")
}

model JogoPlataforma {
  id_jogo_fk       Int
  id_plataforma_fk Int
  jogo             Jogo       @relation(fields: [id_jogo_fk], references: [id_jogo], onDelete: NoAction, onUpdate: NoAction)
  plataforma       Plataforma @relation(fields: [id_plataforma_fk], references: [id_plataforma], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_jogo_fk, id_plataforma_fk])
  @@map("jogo_plataforma")
}

model Genero {
  id_genero   Int          @id @default(autoincrement())
  nome_genero String       @unique
  jogos       JogoGenero[]

  @@map("genero")
}

model JogoGenero {
  id_jogo_fk   Int
  id_genero_fk Int
  jogo         Jogo   @relation(fields: [id_jogo_fk], references: [id_jogo], onDelete: NoAction, onUpdate: NoAction)
  genero       Genero @relation(fields: [id_genero_fk], references: [id_genero], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_jogo_fk, id_genero_fk])
  @@map("jogo_genero")
}

model Avaliacao {
  id_avaliacao    Int      @id @default(autoincrement())
  id_usuario_fk   Int
  id_jogo_fk      Int
  nota            Float
  titulo          String
  texto           String
  data_publicacao DateTime @default(dbgenerated("CURRENT_DATE"))
  usuario         Usuario @relation(fields: [id_usuario_fk], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  jogo            Jogo    @relation(fields: [id_jogo_fk], references: [id_jogo], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_usuario_fk, id_jogo_fk])
  @@map("avaliacao")
}

model ComunicacaoSite {
  id_comunicacao   Int      @id @default(autoincrement())
  email_contato    String
  tipo             String
  mensagem         String
  data_comunicacao DateTime @default(dbgenerated("CURRENT_DATE"))

  @@map("comunicacao_site")
}
